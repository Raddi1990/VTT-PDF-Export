{
  "id": "dnd5e-pdf-exporter",
  "title": "D&D 5e PDF Character Exporter",
  "description": "Exports a dnd5e (2024 rules) character sheet into the official fillable WotC character sheet PDF. Requires the user to supply their own legally obtained copy of the PDF form.",
  "version": "0.1.5",
  "compatibility": {
    "minimum": "12",
    "verified": "13"
  },
  "authors": [
    {
      "name": "Raddi1990"
    }
  ],
  "scripts": [
    "scripts/vendor/pdf-lib.min.js"
  ],
  "esmodules": [
    "src/module.js"
  ],
  "styles": [
    "styles/module.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "de",
      "name": "Deutsch",
      "path": "lang/de.json"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "4.0.0"
        }
      }
    ]
  },
  "url": "https://github.com/Raddi1990/VTT-PDF-Export",
  "manifest": "https://raw.githubusercontent.com/Raddi1990/VTT-PDF-Export/main/module.json",
  "download": "https://github.com/Raddi1990/VTT-PDF-Export/releases/download/v0.1.5/module.zip",
  "readme": "https://github.com/Raddi1990/VTT-PDF-Export/blob/main/README.md",
  "bugs": "https://github.com/Raddi1990/VTT-PDF-Export/issues",
  "license": "LICENSE"
}
